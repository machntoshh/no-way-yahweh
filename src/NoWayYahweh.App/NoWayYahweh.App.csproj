<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NoWayYahweh</AssemblyName>
    <!-- Generated by tools/icon/IconGen.cs -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The browser starts the host directly, so it cannot rely on a system-wide .NET 10 runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoWayYahweh.Core\NoWayYahweh.Core.csproj" />
    <!-- Build order only: the host exe lands in the same output folder. -->
    <ProjectReference Include="..\NoWayYahweh.Host\NoWayYahweh.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icons (Icon="app.ico" in XAML) read it as a WPF resource. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same verse file the extension's blocked page uses (built by tools/verses/). -->
    <EmbeddedResource Include="..\..\extension\verses.json" LogicalName="verses.json" />
  </ItemGroup>

</Project>
