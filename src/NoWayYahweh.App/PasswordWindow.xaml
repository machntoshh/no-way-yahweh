<Window x:Class="NoWayYahweh.App.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha de responsável — No way? Yahweh!" Width="460" SizeToContent="Height"
        Background="{StaticResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="app.ico" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Window.Resources>
    <Style TargetType="PasswordBox">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    </Style>
  </Window.Resources>
  <StackPanel Margin="28,24">
    <TextBlock x:Name="Intro" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,0,0,16" />
    <StackPanel x:Name="CurrentPanel">
      <TextBlock Text="Senha atual" Style="{StaticResource Label}" />
      <PasswordBox x:Name="Current" />
    </StackPanel>
    <StackPanel x:Name="NewPanel">
      <TextBlock Text="Nova senha" Style="{StaticResource Label}" />
      <PasswordBox x:Name="New" />
      <TextBlock Text="Repita a nova senha" Style="{StaticResource Label}" />
      <PasswordBox x:Name="Repeat" />
    </StackPanel>
    <TextBlock x:Name="Feedback" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <DockPanel LastChildFill="False">
      <Button Content="Cancelar" Click="Cancel_Click" DockPanel.Dock="Left" IsCancel="True" />
      <Button x:Name="Ok" Click="Ok_Click" DockPanel.Dock="Right" IsDefault="True" />
    </DockPanel>
  </StackPanel>
</Window>
