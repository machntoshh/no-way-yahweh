<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NoWayYahweh.Host</AssemblyName>
    <ApplicationIcon>..\NoWayYahweh.App\app.ico</ApplicationIcon>
    <!-- Host and app ship side by side; the app registers the host found next to it. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The browser starts the host directly, so it cannot rely on a system-wide .NET 10 runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoWayYahweh.Core\NoWayYahweh.Core.csproj" />
  </ItemGroup>

</Project>
